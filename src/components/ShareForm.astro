---
import type { CollectionEntry } from 'astro:content';
import site from '../data/site.json';
import { checkboxName } from '../lib/plants';
import { ACCEPTED_IMAGE_TYPES } from '../lib/upload';

interface Props {
  plants: CollectionEntry<'plants'>[];
  selected?: string;
  from: string;
  hideHeading?: boolean;
}

const { plants, selected, from, hideHeading = false } = Astro.props;
---

<section class:list={["section", { "no-rule": hideHeading }]} aria-labelledby="share-heading">
  <h2 id="share-heading" class:list={{ "sr-only": hideHeading }}>Share what you know</h2>
  <p>{site.share_blurb}</p>

  <form
    class="form"
    name="share"
    method="POST"
    action="/thank-you/"
    enctype="multipart/form-data"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-astro-reload
  >
    <input type="hidden" name="form-name" value="share" />
    <input type="hidden" name="from_page" value={from} />
    <p class="hidden">
      <label>Leave this empty <input name="bot-field" /></label>
    </p>

    <fieldset>
      <legend>Which plant relative is this about? <span class="hint">Choose as many as you like.</span></legend>
      {
        plants.map((plant) => (
          <label class="choice" style={`--chip:${plant.data.accent}`}>
            <input type="checkbox" name={checkboxName(plant.id)} value="yes" checked={plant.id === selected} />
            <span class="dot" aria-hidden="true"></span>
            <span>
              {plant.data.lakota_name} <span class="hint">({plant.data.english_name})</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <div class="field">
      <label for="share-message">Please share your knowledge, stories, or other information</label>
      <textarea id="share-message" name="message" required></textarea>
    </div>

    <fieldset>
      <legend>Do you know these plants in your language? <span class="hint">Optional</span></legend>
      <p class="legend-note">{site.language_blurb}</p>

      <div class="field">
        <label for="share-language">What language or nation?</label>
        <input id="share-language" type="text" name="language" />
      </div>

      <div class="field">
        <label for="share-language-names">
          What names do you know? <span class="hint">Tell us which plant goes with which name.</span>
        </label>
        <textarea id="share-language-names" class="short" name="language_names"></textarea>
      </div>
    </fieldset>

    <div class="field">
      <label for="share-name">What's your name? <span class="hint">Optional</span></label>
      <input id="share-name" type="text" name="name" autocomplete="name" />
    </div>

    <div class="field">
      <label for="share-tribe">What tribe(s) do you belong to? <span class="hint">Optional</span></label>
      <input id="share-tribe" type="text" name="tribe" />
    </div>

    <div class="field">
      <label for="share-email">Email, in case we have questions <span class="hint">Optional</span></label>
      <input id="share-email" type="email" name="email" autocomplete="email" />
    </div>

    <div class="field">
      <label for="share-photo">Add a photo <span class="hint">Optional</span></label>
      <input id="share-photo" type="file" name="photo" accept={ACCEPTED_IMAGE_TYPES.join(',')} />
      <img class="preview" alt="" hidden />
      <p class="status photo-status" aria-live="polite"></p>
    </div>

    <button class="button" type="submit">Send</button>
  </form>
</section>

<script>
  import { SNIFF_BYTES, sniffImageType } from '../lib/upload';

  /** Biggest file we will even try to decode, so a huge one cannot lock up a phone. */
  const MAX_SOURCE_BYTES = 25 * 1024 * 1024;
  /** Biggest file we will send. */
  const MAX_BYTES = 7 * 1024 * 1024;
  const MAX_EDGE = 1600;

  /**
   * Rebuild a photo from its decoded pixels. A file that is not really an image
   * fails to decode and is refused; one that is loses whatever rode along beside
   * the pixels, including the EXIF tags that record where the photo was taken.
   */
  async function reencode(file: File): Promise<File> {
    const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
    const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    const context = canvas.getContext('2d');
    if (!context) throw new Error('no canvas context');
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
    if (!blob) throw new Error('toBlob failed');
    return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
  }

  function init() {
    for (const form of document.querySelectorAll<HTMLFormElement>('form[name="share"]')) {
      if (form.dataset.ready) continue;
      form.dataset.ready = 'true';
      const input = form.querySelector<HTMLInputElement>('input[type="file"]');
      const status = form.querySelector<HTMLElement>('.photo-status');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const preview = form.querySelector<HTMLImageElement>('.preview');
      if (!input || !status || !submit) continue;

      const say = (message: string, isError = false) => {
        status.textContent = message;
        status.classList.toggle('is-error', isError);
      };

      /** Drop the file as well as complaining, so nothing we refused can be sent. */
      const refuse = (message: string) => {
        input.value = '';
        say(message, true);
      };

      const clearPreview = () => {
        if (!preview) return;
        if (preview.src) URL.revokeObjectURL(preview.src);
        preview.removeAttribute('src');
        preview.hidden = true;
      };

      form.addEventListener('submit', () => {
        submit.textContent = 'Sending…';
        submit.setAttribute('aria-busy', 'true');
      });

      input.addEventListener('change', async () => {
        say('');
        clearPreview();
        const file = input.files?.[0];
        if (!file) return;

        if (file.size > MAX_SOURCE_BYTES) {
          refuse('That file is too big to work with. Please choose a photo under 25 MB.');
          return;
        }

        const head = new Uint8Array(await file.slice(0, SNIFF_BYTES).arrayBuffer());
        if (!sniffImageType(head)) {
          refuse('That file is not a photo. Please choose a JPEG, PNG, WebP or HEIC image.');
          return;
        }

        say('Getting the photo ready…');
        let ready: File;
        try {
          ready = await reencode(file);
        } catch {
          refuse('We could not read that as a photo. Please choose a JPEG, PNG or WebP image.');
          return;
        }

        if (ready.size > MAX_BYTES) {
          refuse('That photo is too large to send (over 7 MB). Please choose a smaller one.');
          return;
        }

        const transfer = new DataTransfer();
        transfer.items.add(ready);
        input.files = transfer.files;

        say(`Photo ready (${(ready.size / 1024 / 1024).toFixed(1)} MB).`);
        if (preview) {
          preview.src = URL.createObjectURL(ready);
          preview.hidden = false;
        }
      });
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
