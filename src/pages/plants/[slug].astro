---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PlantNav from '../../components/PlantNav.astro';
import Pronunciation from '../../components/Pronunciation.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import ShareForm from '../../components/ShareForm.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import Sources from '../../components/Sources.astro';
import { renderMarkdown } from '../../lib/markdown';
import { itemsForPlant, publishedPlants } from '../../lib/plants';

export async function getStaticPaths() {
  const plants = publishedPlants(await getCollection('plants'));
  return plants.map((plant) => ({ params: { slug: plant.id }, props: { plant } }));
}

const { plant } = Astro.props;
const d = plant.data;
const plants = publishedPlants(await getCollection('plants'));
const recipes = itemsForPlant(await getCollection('recipes'), plant.id);
const stories = itemsForPlant(await getCollection('stories'), plant.id);
const { Content } = await render(plant);
const hasStory = Boolean(plant.body && plant.body.trim());
const credit = renderMarkdown(d.hero_credit);
const description = `${d.lakota_name} (${d.english_name}): the Lakota name, how to say it, and what this plant relative is used for.`;
---

<Base title={`${d.lakota_name}, ${d.english_name}`} description={description} accent={d.accent}>
  <PlantNav slot="nav" plants={plants} current={plant.id} />

  <header class:list={["hero", { "has-banner": Boolean(d.hero) }]} data-plant={plant.id} transition:name="hero">
    {
      d.hero && (
        <Image
          class="banner"
          src={d.hero}
          alt={d.english_name}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="wrap">
      <h1 class="lakota" transition:name="plant-name">{d.lakota_name}</h1>
      <p class="english">
        {d.english_name}
        {
          d.scientific_name && (
            <>
              <br />
              <span class="sci">{d.scientific_name}</span>
            </>
          )
        }
      </p>
      <Pronunciation phonetic={d.phonetic} audio={d.audio} />
    </div>
  </header>

  <div class="wrap">
    {credit && <p class="credit" set:html={credit} />}
    {
      hasStory && (
        <section class="story" aria-label="About the name">
          <Content />
        </section>
      )
    }

    <Disclaimer />

    <section class="section" aria-labelledby="uses-heading">
      <h2 id="uses-heading">Uses</h2>
      {
        d.uses.length > 0 ? (
          <ul class="uses">
            {d.uses.map((use) => (
              <li>{use}</li>
            ))}
          </ul>
        ) : (
          <p class="empty">We are still gathering uses for this plant. If you know some, please share them below.</p>
        )
      }
      {
        d.cautions.length > 0 && (
          <aside class="caution">
            <h3>Take care</h3>
            <ul class="uses">
              {d.cautions.map((caution) => (
                <li>{caution}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </section>

    <section class="section" aria-labelledby="recipes-heading">
      <h2 id="recipes-heading">Recipes</h2>
      {
        recipes.length > 0 ? (
          recipes.map((recipe) => <RecipeCard recipe={recipe} />)
        ) : (
          <p class="empty">No recipes yet. Do you have one? Share it below.</p>
        )
      }
    </section>

    {
      stories.length > 0 && (
        <section class="section" aria-labelledby="stories-heading">
          <h2 id="stories-heading">From the community</h2>
          {stories.map((story) => (
            <StoryCard story={story} />
          ))}
        </section>
      )
    }

    <ShareForm plants={plants} selected={plant.id} from={plant.id} />

    <Sources text={d.sources} />
  </div>
</Base>
