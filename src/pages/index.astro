---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Disclaimer from '../components/Disclaimer.astro';
import site from '../data/site.json';
import { renderMarkdown } from '../lib/markdown';
import { plantHref, publishedPlants } from '../lib/plants';

const plants = publishedPlants(await getCollection('plants'));
const credits = renderMarkdown(site.credits);
const intro = renderMarkdown(site.intro);
---

<Base title={site.title} description={site.tagline}>
  <div class="wrap">
    <header class="home-hero">
      <h1>{site.title}</h1>
      <p class="tagline">{site.tagline}</p>
    </header>

    <div class="story" set:html={intro} />

    <section aria-labelledby="plants-heading">
      <h2 id="plants-heading" class="sr-only">Plants</h2>
      <ul class="plant-list">
        {
          plants.map((plant) => (
            <li>
              <a href={plantHref(plant.id)} style={`--chip:${plant.data.accent}`}>
                <span class="swatch" aria-hidden="true">
                  {plant.data.hero && <Image src={plant.data.hero} alt="" width={144} height={144} />}
                </span>
                <span>
                  <span class="name">{plant.data.lakota_name}</span>
                  <br />
                  <span class="sub">
                    {plant.data.english_name}
                    {plant.data.scientific_name && <i> {plant.data.scientific_name}</i>}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="share-home-heading">
      <h2 id="share-home-heading">Share what you know</h2>
      <p>{site.share_blurb}</p>
      <a class="button" href="/share/">Share a use, story or recipe</a>
    </section>

    <section class="section" id="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About this site</h2>
      <div set:html={credits} />
      <Disclaimer />
    </section>
  </div>
</Base>
