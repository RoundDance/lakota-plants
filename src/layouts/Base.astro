---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  accent?: string;
  noindex?: boolean;
}

const { title, description, accent, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.title ? site.title : `${title} | ${site.title}`;
---

<!doctype html>
<html lang="en" style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={accent ?? '#f6f7f2'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Andika:ital,wght@0,400;0,700;1,400&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <a class="brand" href="/">{site.title}</a>
      <nav aria-label="Site">
        <a href="/share/"><span class="long">Share what you know</span><span class="short">Share</span></a>
      </nav>
    </header>
    <slot name="nav" />
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <div class="wrap">
        <p>{site.title}</p>
        <p><a href="/#about">About this site and credits</a></p>
      </div>
    </footer>
  </body>
</html>
